{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "submissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$submissionId": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['name', 'email', 'userId', 'timestamp'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "userId": { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "systemInfo": { ".validate": "newData.hasChildren()" },
        "$other": { ".validate": false }
      }
    },

    "participants": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['playedAt', 'wonPrize']) && (newData.child('redeemed').val() !== true || root.child('admins').child(auth.uid).val() === true)",
        "playedAt": { ".validate": "newData.isString()" },
        "wonPrize": { ".validate": "newData.isBoolean()" },
        "redeemCode": { ".validate": "newData.isString() && newData.val().length === 4" },
        "redeemed": { ".validate": "newData.isBoolean()" },
        "redeemedAt": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "prizes": {
      ".read": "auth != null",
      ".write": "auth != null",
      "remaining": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() === data.val() || newData.val() === data.val() - 1)"
      },
      "$other": { ".validate": false }
    }
  }
}
